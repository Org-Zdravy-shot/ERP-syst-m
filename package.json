{
  "name": "zdravy-shot-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "mkdir -p .next/standalone/.next && cp -R public .next/standalone/ && cp -R .next/static .next/standalone/.next/",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "db:deploy": "prisma migrate deploy",
    "backup:production": "sh scripts/backup-production.sh",
    "admin:production": "sh scripts/create-production-admin.sh",
    "catalog:products": "tsx scripts/sync-product-catalog.ts",
    "finance:omega": "tsx scripts/import-omega.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1094.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "bysquare": "^4.0.0",
    "fflate": "^0.8.3",
    "iron-session": "^8.0.4",
    "next": "16.2.11",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
