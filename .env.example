DATABASE_URL="postgresql://postgres:password@localhost:5432/zdravy_shot?schema=public"
SESSION_SECRET="vygenerujte-prikazom-openssl-rand-hex-32"
# Voliteľné oddelené HMAC tajomstvo pre anonymné login rate-limit kľúče.
# Ak chýba, použije sa SESSION_SECRET. V produkcii musí mať aspoň 32 znakov.
LOGIN_RATE_LIMIT_SECRET=""
INBOX_API_KEY="vygenerujte-prikazom-openssl-rand-hex-32"

# Financie v2 — produkčné vystavenie nechajte false až do účtovníckeho go-live.
FINANCE_PRODUCTION_ISSUING_ENABLED="false"

# Privátny Railway Bucket pre nemenné faktúry a prílohy.
# Hodnoty prepojte referenčnými premennými z Bucket služby.
DOCUMENT_BUCKET_NAME=""
DOCUMENT_BUCKET_ENDPOINT=""
DOCUMENT_BUCKET_REGION="auto"
DOCUMENT_BUCKET_URL_STYLE="virtual"
DOCUMENT_BUCKET_ACCESS_KEY_ID=""
DOCUMENT_BUCKET_SECRET_ACCESS_KEY=""

# FULL SINTEL — monitoring konkurencie (modul Konkurencia)
SINTEL_API_URL="https://sintel-instancia.example.com"
SINTEL_API_KEY="vyziadaj-od-spravcu-full-sintel"

# Financie v2 — Dev C (banka)
CRON_SECRET="vygenerujte-prikazom-openssl-rand-hex-32"
BANK_TOKEN_KEY="vygenerujte-prikazom-openssl-rand-hex-32"
TATRA_PREMIUM_ENABLED="0"
TATRA_API_BASE=""
TATRA_CLIENT_ID=""
TATRA_CLIENT_SECRET=""

# Financie v2 — Dev E (e-mail odosielanie + outbox)
# Railway Hobby blokuje SMTP; produkčne použite Resend HTTPS API.
MAIL_PROVIDER="RESEND"
RESEND_API_KEY=""
# SMTP fallback je použiteľný na Railway Pro alebo mimo Railway.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="0"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="info@zdravyshot.sk"
MAIL_REPLY_TO="info@zdravyshot.sk"
MAIL_FROM_NAME="Zdravý Shot"
# Nastavte na true až po overení DKIM u transakčného poskytovateľa.
FINANCE_MAIL_DKIM_CONFIRMED="false"
REMINDER_GRACE_DAYS="3"
